rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Estante: o dono lê e escreve; outros usuários só leem se o perfil estiver público
    match /users/{uid}/books/{id} {
      allow write: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null && (request.auth.uid == uid
        || get(/databases/$(db)/documents/profiles/$(uid)).data.shelfPublic == true);
    }

    // Quem o usuário segue (privado)
    match /users/{uid}/following/{other} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Perfil: nome e se a estante é pública. A listagem só enxerga perfis públicos.
    match /profiles/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || resource.data.shelfPublic == true);
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'shelfPublic'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.shelfPublic is bool
        && (request.resource.data.shelfPublic == false || request.resource.data.name.size() > 0);
    }

    // Best-sellers do NYT: leitura pública, escrita só pela função agendada
    match /public/{doc} {
      allow read: if true;
    }

    // Comentários públicos: um por pessoa por livro (id do doc = uid)
    match /books/{bookId}/comments/{uid} {
      function validText() {
        return request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40;
      }
      // curtir ou descurtir: só o próprio uid entra ou sai da lista
      function likeToggle() {
        let before = resource.data.likes.toSet();
        let after = request.resource.data.likes.toSet();
        return (after.difference(before).hasOnly([request.auth.uid]) && before.difference(after).size() == 0)
          || (before.difference(after).hasOnly([request.auth.uid]) && after.difference(before).size() == 0);
      }

      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'likes', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.likes == []
        && request.resource.data.createdAt == request.time
        && validText()
        && exists(/databases/$(db)/documents/users/$(uid)/books/$(bookId));
      allow update: if request.auth != null && (
        (request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'name']) && validText())
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) && likeToggle())
      );
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
